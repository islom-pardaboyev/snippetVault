[debug] [2026-10-16T07:17:01.873Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/snippetvault-ed43b/rulesets {"name":"projects/snippetvault-ed43b/rulesets/17fa3713-c215-4c47-b04d-cd6d361f2c08","source":{"files":[{"content":"rules_version = '2';\n\n// SnippetVault — every user can only read and write their own vault.\n// Snippets live at users/{uid}/snippets/{snippetId}.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isOwner(uid) {\n      return request.auth != null && request.auth.uid == uid;\n    }\n    // Only the verified admin email may read the user directory (used by /admin).\n    function isAdmin() {\n      return request.auth != null\n        && request.auth.token.email_verified == true\n        && request.auth.token.email == 'ipardaboyev574@gmail.com';\n    }\n\n    // Public directory: each account owns its own row; the admin can read every row.\n    match /users/{uid} {\n      allow read: if isOwner(uid) || isAdmin();\n      allow create, update: if isOwner(uid)\n        && request.resource.data.email is string && request.resource.data.email.size() <= 320;\n      allow delete: if isOwner(uid);\n    }\n\n    match /users/{uid}/groups/{groupId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && request.resource.data.name is string && request.resource.data.name.size() <= 60;\n    }\n\n    match /users/{uid}/snippets/{snippetId}/images/{imageId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && request.resource.data.data is string && request.resource.data.data.size() <= 900000\n        && request.resource.data.data.matches('^data:image/.*');\n    }\n\n    match /users/{uid}/snippets/{snippetId}/versions/{versionId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && request.resource.data.code is string && request.resource.data.code.size() <= 200000\n        // A page's content rides along in `notes`, so cap it too (same headroom as the snippet).\n        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 200000));\n    }\n\n    match /users/{uid}/snippets/{snippetId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && request.resource.data.title is string && request.resource.data.title.size() <= 200\n        && request.resource.data.code is string && request.resource.data.code.size() <= 200000\n        && request.resource.data.tags is list && request.resource.data.tags.size() <= 30\n        // Notes are rich text now (headings, lists, highlighted code), so the cap has the same\n        // headroom as `code` above: the editor itself limits the plain text to 20k characters.\n        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 200000));\n    }\n\n    // Private Vault. The payloads are AES-GCM ciphertext, so the rules only ever\n    // check the shape and size — never the (unreadable) contents.\n    //   users/{uid}/meta/vault                             → KDF params + wrapped data key\n    //   users/{uid}/vault/{itemId}                         → an encrypted snippet\n    //   users/{uid}/vault/{itemId}/images/{imageId}        → an encrypted image\n    match /users/{uid}/meta/{docId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && request.resource.data.wrapped_dek is string && request.resource.data.wrapped_dek.size() <= 4000;\n    }\n\n    // A vault image is either sealed inline (`enc`) or a pointer to the ciphertext hosted\n    // on imgbb (`remote`) — never both, so a hosted image is ~300 bytes instead of ~700 KB.\n    // Only the shape/size is checkable; the bytes are unreadable either way.\n    match /users/{uid}/vault/{itemId}/images/{imageId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && (\n          (\n            'enc' in request.resource.data\n            && request.resource.data.enc.iv is string && request.resource.data.enc.iv.size() <= 64\n            && request.resource.data.enc.ct is string && request.resource.data.enc.ct.size() <= 950000\n          ) || (\n            'remote' in request.resource.data\n            && request.resource.data.remote.url is string\n            && request.resource.data.remote.url.matches('^https://.*')\n            && request.resource.data.remote.url.size() <= 600\n            && request.resource.data.remote.iv is string && request.resource.data.remote.iv.size() <= 64\n            && request.resource.data.remote.sha is string && request.resource.data.remote.sha.size() <= 64\n            && request.resource.data.remote.bytes is int\n            && request.resource.data.remote.bytes > 0\n            && request.resource.data.remote.bytes <= 4000000\n            && (!('delete_url' in request.resource.data.remote)\n                || request.resource.data.remote.delete_url == null\n                || (request.resource.data.remote.delete_url is string\n                    && request.resource.data.remote.delete_url.size() <= 600))\n          )\n        );\n    }\n\n    match /users/{uid}/vault/{itemId} {\n      allow read, delete: if request.auth != null && request.auth.uid == uid;\n      allow create, update: if request.auth != null && request.auth.uid == uid\n        && request.resource.data.enc.iv is string && request.resource.data.enc.iv.size() <= 64\n        && request.resource.data.enc.ct is string && request.resource.data.enc.ct.size() <= 900000;\n    }\n\n    // Read-only share links. Anyone with the (unguessable) token can read;\n    // only the owner can create the link or revoke it.\n    //\n    // Expiry is enforced here, not just in the app: a share stores `expires_at_ts`\n    // (a Firestore timestamp — a far-future one when the link never expires), and once\n    // the server clock passes it the document can no longer be read at all, so an expired\n    // link leaks nothing even if someone keeps the URL. A share written before this field\n    // existed has none, which readers below treat as the same far-future default.\n    match /shares/{token} {\n      function ownsShare() {\n        return request.auth != null\n          && get(/databases/$(database)/documents/shares/$(token)).data.owner_id == request.auth.uid;\n      }\n      // `resource == null` lets a read of a missing share succeed with \"not found\"\n      // instead of failing closed with permission-denied. A missing `expires_at_ts`\n      // defaults to a far-future date, i.e. \"never expires\".\n      function shareOpen() {\n        return resource == null\n          || request.time < resource.data.get('expires_at_ts', timestamp.date(9999, 12, 31));\n      }\n      function isOwnerOfToken() {\n        return request.auth != null && resource != null\n          && resource.data.owner_id == request.auth.uid;\n      }\n      // The same check for the sub-collections, which look the parent up by token.\n      function parentOpen() {\n        let parent = get(/databases/$(database)/documents/shares/$(token));\n        return parent == null\n          || request.time < parent.data.get('expires_at_ts', timestamp.date(9999, 12, 31));\n      }\n\n      allow read: if shareOpen() || isOwnerOfToken();\n      allow create: if request.auth != null\n        && request.resource.data.owner_id == request.auth.uid\n        && request.resource.data.kind in ['snippet', 'group']\n        && request.resource.data.title is string && request.resource.data.title.size() <= 200\n        && (!('owner_name' in request.resource.data)\n            || (request.resource.data.owner_name is string && request.resource.data.owner_name.size() <= 320))\n        && (!('group' in request.resource.data)\n            || (request.resource.data.group is string && request.resource.data.group.size() <= 100));\n      allow delete: if request.auth != null && resource.data.owner_id == request.auth.uid;\n      // The owner can change anything; anyone else may only bump the view counter by one.\n      allow update: if (request.auth != null && resource.data.owner_id == request.auth.uid)\n        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])\n            && request.resource.data.views is int\n            && request.resource.data.views == resource.data.get('views', 0) + 1);\n\n      match /snippets/{snippetId} {\n        allow read: if parentOpen() || ownsShare();\n        allow create, update: if ownsShare()\n          && request.resource.data.code is string && request.resource.data.code.size() <= 200000\n          // A page's content rides along in `notes`, so cap it here too.\n          && (!('notes' in request.resource.data)\n              || (request.resource.data.notes is string && request.resource.data.notes.size() <= 200000));\n        allow delete: if ownsShare();\n\n        match /images/{imageId} {\n          allow read: if parentOpen() || ownsShare();\n          allow create, update: if ownsShare()\n            && request.resource.data.data is string && request.resource.data.data.size() <= 900000\n            && request.resource.data.data.matches('^data:image/.*');\n          allow delete: if ownsShare();\n        }\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-16T07:17:01.963887Z","metadata":{"services":["cloud.firestore"]}}
