# Copy to .env (git-ignored) and fill in. Restart `npm run dev` / rebuild after changing.

# The only account allowed to open /admin
VITE_ADMIN_EMAIL=you@example.com

# The admin passcode, written as plain text. It is hashed at build time (SHA-256),
# so the passcode itself is never shipped in the site's JavaScript. Use 12+ characters.
ADMIN_PASSCODE=
