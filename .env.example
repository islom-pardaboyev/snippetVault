# Copy to .env (git-ignored) and fill in. Restart `npm run dev` / rebuild after changing.

# The only account allowed to open /admin
VITE_ADMIN_EMAIL=you@example.com

# The admin passcode, written as plain text. It is hashed at build time (SHA-256),
# so the passcode itself is never shipped in the site's JavaScript. Use 12+ characters.
ADMIN_PASSCODE=

# OPTIONAL — imgbb API key for the Vault's unlimited images (https://imgbb.com/api).
# Get one free at https://imgbb.com/api (Personal use → Upload without limits).
# Create a key from an account you can rotate; because this site is client-only the key
# ships inside the JavaScript bundle, so treat it as public-but-revocable.
# Vault images are encrypted on your device BEFORE this key is used — imgbb only ever
# sees ciphertext. Without a key the vault still works, storing images inline instead.
IMB_API=
